{
  "name": "crenel",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "description": "A defensive security harness for SaaS: harden your own app, validate findings with replayable proof, and measure your tools before you trust them.",
  "type": "module",
  "bin": {
    "crenel": "./dist/cli.js",
    "bastion": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "toolbox"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:bench": "node --test \"bench/**/*.test.mjs\"",
    "benchmark": "node bench/run.mjs --strict",
    "demo": "tsx src/cli.ts scan --config examples/crenel.config.yaml",
    "sync-denylist": "node scripts/sync-denylist.mjs",
    "crenel": "tsx src/cli.ts",
    "build:sea": "node scripts/build-sea.mjs",
    "smoke:binary": "node scripts/smoke-binary.mjs build/release/crenel"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "picocolors": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  }
}
