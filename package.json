{
  "name": "crenel",
  "version": "0.1.0",
  "description": "A defensive security harness for SaaS: harden your own app, validate findings with replayable proof, and measure your tools before you trust them.",
  "type": "module",
  "bin": {
    "crenel": "./dist/cli.js",
    "bastion": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "demo": "tsx src/cli.ts scan --config examples/crenel.config.yaml",
    "sync-denylist": "node scripts/sync-denylist.mjs",
    "crenel": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "picocolors": "1.1.1",
    "yaml": "2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
